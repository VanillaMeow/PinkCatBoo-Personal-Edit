{
	"$schema": "vscode://schemas/color-theme",
	"name": "Pink Cat Boo (Leah Edit)",
	"colors": {
		// Global accents
		"badge.background": "#F075AE",
		"badge.foreground": "#ffffff",
		"focusBorder": "#F075AE",
		"sash.hoverBorder": "#F075AE",

		// Activity bar and command center
		"activityBar.background": "#202330",
		"activityBar.foreground": "#fde3e8",
		"activityBarBadge.background": "#F075AE",
		"commandCenter.background": "#2d2f42",
		"commandCenter.border": "#565970",
		"commandCenter.foreground": "#fde3e8",

		// Buttons and form controls
		"button.background": "#F075AEcc",
		"button.hoverBackground": "#F075AE",
		"dropdown.background": "#202330",
		"input.background": "#202330",
		"input.border": "#565970",
		"input.placeholderForeground": "#9498a1",
		"inputOption.activeBackground": "#F075AE33",
		"inputOption.activeBorder": "#F075AE",

		// Editor surfaces and guides
		"editor.background": "#202330",
		"editor.foreground": "#FFF0F5",
		"editor.lineHighlightBackground": "#472541",
		"editor.selectionBackground": "#472541",
		"editor.selectionHighlightBackground": "#575b6180",
		"editor.wordHighlightBackground": "#4747a180",
		"editor.wordHighlightStrongBackground": "#6767ce80",
		"editorBracketMatch.border": "#d0963a",
		"editorCursor.foreground": "#ffedf0",
		"editorError.foreground": "#ff62a5",
		"editorGroupHeader.tabsBackground": "#2d2f42",
		"editorHint.foreground": "#DCBFF2",
		"editorInfo.foreground": "#73b5d7",
		"editorInlayHint.background": "#2d2f4280",
		"editorInlayHint.foreground": "#9498a1",
		"editorInlayHint.parameterBackground": "#2d2f4280",
		"editorInlayHint.parameterForeground": "#9CD162",
		"editorInlayHint.typeBackground": "#2d2f4280",
		"editorInlayHint.typeForeground": "#DCBFF2",
		"editorStickyScroll.background": "#2d2f42",
		"editorStickyScrollHover.background": "#565970",
		"editorWarning.foreground": "#3bc089",

		// Lists, menus, and panels
		"list.activeSelectionBackground": "#d0963a",
		"list.errorForeground": "#ff62a5",
		"list.focusBackground": "#707070",
		"list.highlightForeground": "#FFFFFF",
		"list.hoverBackground": "#565970",
		"list.inactiveSelectionBackground": "#765d36",
		"menu.separatorBackground": "#f3b4bf",
		"panel.background": "#202330",
		"panel.border": "#565970",
		"panelTitle.activeBorder": "#F075AE",
		"panelTitle.activeForeground": "#ffffff",
		"peekView.border": "#d0963a",
		"peekViewEditor.background": "#252738",
		"peekViewResult.background": "#2d2f42",
		"peekViewTitle.background": "#2d2f42",

		// Notifications and extension UI
		"extensionButton.prominentBackground": "#F075AE",
		"extensionButton.prominentForeground": "#ffffff",
		"extensionButton.prominentHoverBackground": "#F075AE",
		"notificationCenter.border": "#f3b4bf",
		"notificationCenterHeader.background": "#f3b4bf",
		"notificationCenterHeader.foreground": "#ffffff",
		"notificationLink.foreground": "#F075AE",
		"notifications.background": "#6d5d72",
		"notifications.foreground": "#f3b4bf",

		// Minimap and scrollbar
		"minimap.background": "#202330",
		"minimap.findMatchHighlight": "#d0963a80",
		"minimap.selectionHighlight": "#4725417a",
		"scrollbarSlider.activeBackground": "#e9a6b288",
		"scrollbarSlider.background": "#f3b4bf48",
		"scrollbarSlider.hoverBackground": "#f3b4bf66",

		// Sidebar, tabs, title bar, and status bar
		"sideBar.background": "#2d2f42",
		"sideBar.foreground": "#fde3e8",
		"sideBarSectionHeader.background": "#202330",
		"sideBarTitle.foreground": "#F075AE",
		"statusBar.background": "#191B2C",
		"statusBar.debuggingBackground": "#472541",
		"statusBar.debuggingForeground": "#FFF0F5",
		"statusBar.foreground": "#FFF0F5",
		"statusBar.noFolderBackground": "#191B2C",
		"tab.activeBorderTop": "#F075AE",
		"tab.activeForeground": "#F075AE",
		"tab.border": "#9498a144",
		"tab.hoverBackground": "#565970",
		"tab.inactiveBackground": "#2d2f42",
		"tab.inactiveForeground": "#9498a1",
		"titleBar.activeBackground": "#2d2f42",
		"titleBar.activeForeground": "#fde3e8",
		"titleBar.inactiveBackground": "#202330",

		// Terminal
		"terminal.ansiBlack": "#202330",
		"terminal.ansiBlue": "#73b5d7",
		"terminal.ansiBrightBlack": "#6D7A72",
		"terminal.ansiBrightBlue": "#A2C2EB",
		"terminal.ansiBrightCyan": "#73b5d7",
		"terminal.ansiBrightGreen": "#9CD162",
		"terminal.ansiBrightMagenta": "#E6A1FF",
		"terminal.ansiBrightRed": "#FF38A2",
		"terminal.ansiBrightWhite": "#FFF0F5",
		"terminal.ansiBrightYellow": "#FAE8B6",
		"terminal.ansiCyan": "#94AFE8",
		"terminal.ansiGreen": "#58B896",
		"terminal.ansiMagenta": "#DCBFF2",
		"terminal.ansiRed": "#ff62a5",
		"terminal.ansiWhite": "#ffffff",
		"terminal.ansiYellow": "#ffc85b",
		"terminalCursor.foreground": "#F075AE",

		// Git decorations
		"gitDecoration.addedResourceForeground": "#58B896",
		"gitDecoration.conflictingResourceForeground": "#FF38A2",
		"gitDecoration.deletedResourceForeground": "#ff62a5",
		"gitDecoration.ignoredResourceForeground": "#6D7A72",
		"gitDecoration.modifiedResourceForeground": "#ffc85b",
		"gitDecoration.untrackedResourceForeground": "#9CD162"
	},
	"tokenColors": [
		// Base defaults
		{
			"settings": {
				"foreground": "#FFF0F5"
			}
		},
		// {
		// 	"name": "Base",
		// 	"scope": "source.python",
		// 	"settings": {
		// 		"foreground": "#EBA4AC"
		// 	}
		// },

		// Core syntax
		{
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"foreground": "#6D7A72"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"foreground": "#FAE8B6"
			}
		},
		{
			"name": "Docstring",
			"scope": "string.quoted.docstring",
			"settings": {
				"foreground": "#60965b"
			}
		},
		{
			"name": "Number",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#FF38A2"
			}
		},
		{
			"name": "Built-in constant",
			"scope": [
				"constant.language",
				"constant.language.python"
			],
			"settings": {
				"foreground": "#58B896"
			}
		},
		{
			"name": "User-defined constant",
			"scope": "constant.character, constant.other",
			"settings": {
				"foreground": "#FF7F9D"
			}
		},
		{
			"name": "Keyword",
			"scope": "keyword",
			"settings": {
				"foreground": "#FF4791"
			}
		},
		{
			"name": "Control flow keywords",
			"scope": [
				"keyword.control",
				"keyword.control.exception.python",
				"keyword.control.flow",
				"keyword.control.flow.python",
				"keyword.control.import.python"
			],
			"settings": {
				"foreground": "#FF4791"
			}
		},
		{
			"name": "Storage",
			"scope": "storage",
			"settings": {
				"foreground": "#FEC831"
			}
		},
		{
			"name": "Storage Type",
			"scope": [
				"storage.type",
				"storage.type.class.python",
				"storage.type.function.python"
			],
			"settings": {
				"fontStyle": "italic",
				// "foreground": "#FF4791"
				"foreground": "#DCBFF2"
			}
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": {
				"foreground": "#FFFFFF"
			}
		},

		// Python and general programming scopes
		{
			"name": "Class name",
			"scope": [
				"entity.name.class",
				"entity.name.type.class.python"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#94AFE8"
			}
		},
		{
			"name": "Inherited class",
			"scope": [
				"entity.other.inherited-class",
				"entity.other.inherited-class.python"
			],
			"settings": {
				"fontStyle": "italic underline",
				"foreground": "#37e884"
			}
		},
		{
			"name": "Function name",
			"scope": [
				"entity.name.function",
				"entity.name.function.python"
			],
			"settings": {
				"foreground": "#ffc85b"
			}
		},
		{
			"name": "Decorator",
			"scope": [
				"entity.name.function.decorator.python",
				"meta.function.decorator.python"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#ffc85b"
			}
		},
		{
			"name": "Decorator @ symbol",
			"scope": "punctuation.definition.decorator.python",
			"settings": {
				"foreground": "#ffc85b"
			}
		},
		{
			"name": "Function argument",
			"scope": [
				"variable.parameter",
				"variable.parameter.function.language.python",
				"variable.parameter.function.python"
			],
			"settings": {
				"foreground": "#9CD162"
			}
		},
		{
			"name": "Python self/cls",
			"scope": [
				"variable.language.special.cls.python",
				"variable.language.special.self.python",
				"variable.parameter.function.language.special.self.python",
				"variable.parameter.self.python"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#94558d"
			}
		},
		{
			"name": "Python built-in functions",
			"scope": [
				"support.function.builtin.python"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#A2C2EB"
			}
		},
		{
			"name": "Python magic methods",
			"scope": [
				"support.function.magic.python",
				"support.variable.magic.python"
			],
			"settings": {
				"foreground": "#ae00ae"
			}
		},
		{
			"name": "Python built-in types",
			"scope": [
				"support.type.exception.python",
				"support.type.python"
			],
			"settings": {
				"foreground": "#94AFE8"
			}
		},
		{
			"name": "F-string expressions",
			"scope": [
				"meta.embedded.python",
				"meta.fstring.python",
				"string.interpolated.python"
			],
			"settings": {
				"foreground": "#FAE8B6"
			}
		},
		{
			"name": "F-string prefix",
			"scope": [
				"storage.type.string.python"
			],
			"settings": {
				"foreground": "#dcbff2"
			}
		},
		{
			"name": "Library function",
			"scope": "support.function",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#A2C2EB"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable.other",
				"variable.other.readwrite.python"
			],
			"settings": {
				"foreground": "#EBA4AC"
			}
		},
		{
			"name": "Property access",
			"scope": "variable.other.property",
			"settings": {
				"foreground": "#DCBFF2"
			}
		},

		// Markup, templates, and web
		{
			"name": "Tag",
			"scope": "meta.tag",
			"settings": {
				"foreground": "#FFF0F5"
			}
		},
		{
			"name": "Tag name",
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#FA508C"
			}
		},
		{
			"name": "Tag Attribute",
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#E6A1FF"
			}
		},
		{
			"name": "HTML Tags punctuation",
			"scope": [
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag.end",
				"punctuation.definition.tag.html"
			],
			"settings": {
				"foreground": "#FFF0F5"
			}
		},
		{
			"name": "CSS class and type",
			"scope": [
				"support.class",
				"support.type"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#94AFE8"
			}
		},
		{
			"name": "Template expression",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#D08442"
			}
		},
		{
			"name": "Template expression content",
			"scope": "meta.template.expression",
			"settings": {
				"foreground": "#FFF0F5"
			}
		},
		{
			"name": "SQL keywords",
			"scope": "keyword.other.DML.sql",
			"settings": {
				"foreground": "#D0B344"
			}
		},

		// Diff and markdown
		{
			"name": "Diff header",
			"scope": [
				"meta.diff",
				"meta.diff.header"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E0EDDD"
			}
		},
		{
			"name": "Diff deleted",
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#ff62a5"
			}
		},
		{
			"name": "Diff changed",
			"scope": "markup.changed",
			"settings": {
				"foreground": "#ffc85b"
			}
		},
		{
			"name": "Diff inserted",
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#58B896"
			}
		},
		{
			"name": "Markup quote",
			"scope": "markup.quote",
			"settings": {
				"foreground": "#9e6dbc"
			}
		},
		{
			"name": "Markup list",
			"scope": "markup.list",
			"settings": {
				"foreground": "#73b5d7"
			}
		},
		{
			"name": "Markup bold",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#F5A6C6"
			}
		},
		{
			"name": "Markup italic",
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#DCBFF2"
			}
		},
		{
			"name": "Markup inline code",
			"scope": "markup.inline.raw",
			"settings": {
				"foreground": "#FF38A2"
			}
		},
		{
			"name": "Markup heading",
			"scope": [
				"markup.heading",
				"markup.heading.setext"
			],
			"settings": {
				"foreground": "#D0B344"
			}
		},

		// Custom token scopes
		{
			"name": "Info token",
			"scope": "token.info-token",
			"settings": {
				"foreground": "#73b5d7"
			}
		},
		{
			"name": "Warn token",
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#ffc85b"
			}
		},
		{
			"name": "Error token",
			"scope": "token.error-token",
			"settings": {
				"foreground": "#ff62a5"
			}
		},
		{
			"name": "Debug token",
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#DCBFF2"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		// Functions and methods
		"function": "#ffc85b",
		"function.builtin": {
			"foreground": "#A2C2EB",
			"fontStyle": "bold"
		},
		"function.defaultLibrary": {
			"foreground": "#A2C2EB",
			"fontStyle": "bold"
		},
		"magicFunction": "#ae00ae",
		"magicFunction.declaration": "#ae00ae",
		"method.declaration": "#ffc85b",

		// Classes and types
		"class.builtin": {
			"foreground": "#94AFE8",
			"fontStyle": "italic"
		},
		"class.declaration": {
			"foreground": "#94AFE8",
			"fontStyle": "italic"
		},
		"class.decorator": {
			"foreground": "#ffc85b",
			"fontStyle": "italic"
		},
		"type": "#94AFE8",
		"type.defaultLibrary": "#94AFE8",

		// Variables and properties
		"builtinConstant": "#58B896",
		"builtinConstant.readonly": "#58B896",
		"parameter": "#9CD162",
		"property": "#DCBFF2",
		"variable": "#EBA4AC",
		"variable.classMember": "#DCBFF2",
		"variable.declaration": "#EBA4AC",
		"variable.defaultLibrary": "#58B896",
		"variable.readonly": "#FF7F9D",

		// Modules and namespaces
		"module": "#73b5d7",
		"namespace": "#73b5d7",

		// Python-specific parameters
		"clsParameter": {
			"foreground": "#94558d",
			"fontStyle": "italic"
		},
		"selfParameter": {
			"foreground": "#94558d",
			"fontStyle": "italic"
		}
	}
}
